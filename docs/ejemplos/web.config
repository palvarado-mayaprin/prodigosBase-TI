<?xml version="1.0" encoding="UTF-8"?>
<!--
  prodigosBase-TI: configuración de ejemplo para IIS (URL Rewrite 2.1 y
  FastCGI con PHP 8.4). Copiar a public\web.config; el sitio apunta a public.
  Pendiente de validar en un servidor IIS (MANUAL_INSTALACION_Y_CONFIGURACION.md, sección 9).
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <!-- Las páginas de error (403, 404, 419, 429, 500 y 503) las genera Laravel. -->
    <httpErrors existingResponse="PassThrough" />
    <rewrite>
      <rules>
        <!-- Sin barra final, salvo en carpetas reales. -->
        <rule name="Quitar barra final" stopProcessing="true">
          <match url="^(.*)/$" ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
          </conditions>
          <action type="Redirect" redirectType="Permanent" url="/{R:1}" />
        </rule>
        <!-- Todo lo que no sea un archivo o carpeta de public lo atiende index.php. -->
        <rule name="Laravel" stopProcessing="true">
          <match url="^" ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
