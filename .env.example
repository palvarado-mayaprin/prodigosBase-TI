APP_NAME="prodigosBase-TI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQL Server es obligatorio. Cada desarrollador usa su propia base vacía.
# Nunca se versionan credenciales reales: estos valores son ejemplos.
DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=prodigos_base_dev
DB_USERNAME=
DB_PASSWORD=
DB_URL=
# ODBC Driver 18 cifra por defecto: definir según el certificado del servidor.
# DB_ENCRYPT=yes
# DB_TRUST_SERVER_CERTIFICATE=false

# Sesión, caché y cola en archivos: no requieren tablas en SQL Server.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true   (solo con HTTPS)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Control centralizado de entornos y escrituras (config/entorno.php,
# App\Entorno\DestinoSql). ADM_ENTORNO debe coincidir con DB_DATABASE.
# Verificar siempre con: php artisan adm:entorno
ADM_ENTORNO=desarrollo
# Único interruptor de escritura en producción (sin efecto en desarrollo).
ADM_PRODUCCION_ESCRITURA=false
# Destinos autorizados: nombre devuelto por @@SERVERNAME y base de cada entorno.
# Desarrollo y producción no pueden ser el mismo servidor y base.
ADM_DESARROLLO_SERVIDOR=
ADM_DESARROLLO_BD=prodigos_base_dev
ADM_PRODUCCION_SERVIDOR=
ADM_PRODUCCION_BD=
# Con APP_ENV=production, redes CIDR admitidas (separadas por comas).
# Vacío rechaza todo acceso. En local solo se admite el propio equipo.
ADM_REDES_CORPORATIVAS=
# Descripción que acompaña a APP_NAME en el inicio de sesión.
ADM_APP_DESCRIPCION="Plataforma administrativa"
# Zona horaria en que se muestran y filtran las fechas (se guardan en UTC).
ADM_ZONA_HORARIA=UTC
# ADM_DESPLIEGUE_DDL nunca va en este archivo: se define solo en la consola
# de despliegue para autorizar migraciones en producción.
